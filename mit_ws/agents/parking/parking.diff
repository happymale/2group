+                self.get_logger().info(f'{mission.id}: 실제 자세 {np.round(pose, 2).tolist()}에서 나가는 경로 다시 만듦 '
+                                       f'(R {self.park_cfg.min_radius * scale * k:.2f}, 여유 {clearance:.2f})')
