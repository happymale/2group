+                          'gear': int(gear), 'remaining': round(rem, 2) if math.isfinite(rem) else None,
+                          'hold': round(now - self.park_hold_since, 1) if self.park_hold_since else None}
+        self.publish_status('parking_' + name, speed=cap)
