+        low, high = self.current_zone[0] - 5.0, self.current_zone[1] + 5.0
+        station, lateral = self.reference.project(xy, low - 5.0, high + 5.0)
+        keep = (station > low) & (station < high) & (np.abs(lateral) < self.road_half_width + 0.75)
